{
  "schemaVersion": 1,
  "id": "netheritebuckets",
  "version": "${version}",

  "name": "Netherite Buckets",
  "description": "Adds netherite buckets and cauldrons. A more appropriate way to handle lava.",
  "authors": [
    "TheRedBrain"
  ],
  "contact": {
    "sources": "https://github.com/TheRedBrain/food-overhaul"
  },
  "license": "MIT",
  "icon": "assets/netheritebuckets/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.theredbrain.netheritebuckets.NetheriteBuckets"
    ],
    "client": [
      "com.github.theredbrain.netheritebuckets.NetheriteBucketsClient"
    ]
  },
  "custom": {
    "fzzy_config": [
      "netheritebuckets"
    ]
  },
  "mixins": [
    "netheritebuckets.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "fzzy_config": ">=${fzzy_config_version}"
  }
}
